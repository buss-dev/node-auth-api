{
  "name": "node-auth-api",
  "version": "1.0.0",
  "type": "module",
  "description": "API de autenticação em Node.js.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "db:create-tables": "tsx --env-file=.env src/scripts/create-tables.ts",
    "db:seed": "tsx --env-file=.env src/scripts/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buss-dev/node-auth-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/buss-dev/node-auth-api/issues"
  },
  "homepage": "https://github.com/buss-dev/node-auth-api#readme",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1127.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
